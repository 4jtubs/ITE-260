students = [
]

statuses = ["Enrolled", "Dropped", "Graduated"]

choice = ""

while choice != "0":
    print("\n===== STUDENT INFORMATION SYSTEM =====")
    print("1. Add student")
    print("2. View all students")
    print("3. Search student")
    print("4. Update student")
    print("5. Delete student")
    print("6. Change student status")
    print("7. Status summary")
    print("0. Exit")
    choice = input("Choose: ").strip()

    if choice == "1":
        new_id = input("Student ID: ").strip()
        exists = False
        for s in students:
            if s[0] == new_id:
                exists = True

        if new_id == "":
            print("ID cannot be empty.")
        elif exists:
            print("That ID already exists.")
        else:
            name = input("Name: ").strip()
            course = input("Course: ").strip()
            year = input("Year level (1-4): ").strip()
            if name == "" or course == "":
                print("Name and course cannot be empty.")
            elif year not in ["1", "2", "3", "4"]:
                print("Year level must be 1, 2, 3, or 4.")
            else:
               
                students.append([new_id, name, course, int(year), "Enrolled"])
                print("Student added.")

    elif choice == "2":
        if len(students) == 0:
            print("No students yet.")
        else:
            print(f"\n{'ID':<10}{'Name':<20}{'Course':<8}{'Year':<6}{'Status'}")
            for s in students:
                print(f"{s[0]:<10}{s[1]:<20}{s[2]:<8}{s[3]:<6}{s[4]}")
            print("Total students:", len(students))

    elif choice == "3":
        keyword = input("Enter ID or name: ").strip().lower()
        found = False
        for s in students:
            if keyword in s[0].lower() or keyword in s[1].lower():
                print(f"{s[0]} | {s[1]} | {s[2]} | Year {s[3]} | {s[4]}")
                found = True
        if not found:
            print("No student found.")

    elif choice == "4":
        search_id = input("Student ID to update: ").strip()
        found = False
        for s in students:
            if s[0] == search_id:
                found = True
                print("Leave blank to keep the old value.")
                new_name = input(f"Name ({s[1]}): ").strip()
                new_course = input(f"Course ({s[2]}): ").strip()
                new_year = input(f"Year level ({s[3]}): ").strip()
                if new_name != "":
                    s[1] = new_name
                if new_course != "":
                    s[2] = new_course
                if new_year in ["1", "2", "3", "4"]:
                    s[3] = int(new_year)
                print("Student updated.")
        if not found:
            print("Student ID not found.")

    elif choice == "5":
        delete_id = input("Student ID to delete: ").strip()
        position = -1
        for i in range(len(students)):
            if students[i][0] == delete_id:
                position = i
        if position == -1:
            print("Student ID not found.")
        else:
            sure = input("Are you sure? (y/n): ").strip().lower()
            if sure == "y":
                students.pop(position)
                print("Student deleted.")
            else:
                print("Delete cancelled.")

    elif choice == "6":
        status_id = input("Student ID: ").strip()
        found = False
        for s in students:
            if s[0] == status_id:
                found = True
                print(f"Current status: {s[4]}")
                print("1. Enrolled")
                print("2. Dropped")
                print("3. Graduated")
                pick = input("Choose new status (1-3): ").strip()
                if pick in ["1", "2", "3"]:
                    s[4] = statuses[int(pick) - 1]
                    print("Status changed to", s[4])
                else:
                    print("Invalid choice. Status not changed.")
        if not found:
            print("Student ID not found.")

    elif choice == "7":
        if len(students) == 0:
            print("No students yet.")
        else:
            print("\n--- Status Summary ---")
            for status in statuses:
                count = 0
                for s in students:
                    if s[4] == status:
                        count = count + 1
                print(f"{status:<10}: {count}")
            print("Total     :", len(students))

    elif choice == "0":
        print("Goodbye!")

    else:
        print("Invalid choice. Try again.")
